<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Notemaster.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"
    xmlns:pages="clr-namespace:Notemaster.Pages"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="White"
    Shell.TabBarForegroundColor="{StaticResource Primary}"
    Shell.TabBarTitleColor="{StaticResource Primary}"
    Shell.TabBarUnselectedColor="{StaticResource NMMuted}"
    Title="Notemaster">
    
    <ShellContent ContentTemplate="{DataTemplate pages:LoginPage}" Route="login" />
    <ShellContent ContentTemplate="{DataTemplate pages:RegisterPage}" Route="register" />
    <ShellContent ContentTemplate="{DataTemplate pages:RecoveryPage}" Route="recovery" />
    <TabBar>
    <ShellContent Title="Accueil"
                  Icon="{StaticResource NMIconHome}"
                  ContentTemplate="{DataTemplate pages:HomePage}"
                  Route="home" />
    <ShellContent Title="Mes cours"
                  Icon="{StaticResource NMIconCourses}"
                  ContentTemplate="{DataTemplate pages:CoursesPage}"
                  Route="courses" />
    <ShellContent Title="Profil"
                  Icon="{StaticResource NMIconProfile}"
                  ContentTemplate="{DataTemplate pages:ProfilePage}"
                  Route="profile" />
    </TabBar>
   

    <Shell.FlyoutFooter>
        <Grid Padding="15">
            <sf:SfSegmentedControl x:Name="ThemeSegmentedControl" 
                VerticalOptions="Center" HorizontalOptions="Center" SelectionChanged="SfSegmentedControl_SelectionChanged"
                SegmentWidth="40" SegmentHeight="40">
                <sf:SfSegmentedControl.ItemsSource>
                    <x:Array Type="{x:Type sf:SfSegmentItem}">
                        <sf:SfSegmentItem ImageSource="{StaticResource IconLight}" SemanticProperties.Description="Light mode"/>
                        <sf:SfSegmentItem ImageSource="{StaticResource IconDark}" SemanticProperties.Description="Dark mode"/>
                    </x:Array>
                </sf:SfSegmentedControl.ItemsSource>
            </sf:SfSegmentedControl>
        </Grid>
    </Shell.FlyoutFooter>

</Shell>
