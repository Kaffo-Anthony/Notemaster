<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:f="clr-namespace:Fonts"
             xmlns:models="clr-namespace:Notemaster.Models"
             x:Class="Notemaster.Pages.GeneratedPage"
             Title="Fiches générées"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource NMBackground}">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <Grid Padding="20,12,20,20" RowSpacing="12" RowDefinitions="Auto,Auto,*,Auto"
          WidthRequest="{OnIdiom -1, Desktop=420, Tablet=420}"
          HorizontalOptions="{OnIdiom Fill, Desktop=Center, Tablet=Center}">

        <!-- Cours de rattachement -->
        <Border Grid.Row="0" BackgroundColor="{StaticResource NMSoft}" StrokeThickness="0" Padding="14,12">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Label Style="{StaticResource NMIconGlyph}" Text="{x:Static f:FluentUI.attach_24_regular}" />
                <Label x:Name="CourseLabel" Grid.Column="1" Style="{StaticResource NMSectionTitle}"
                       FontSize="16" VerticalOptions="Center" />
            </Grid>
        </Border>
        <Label Grid.Row="1" x:Name="CountLabel" Style="{StaticResource NMMuted}" FontSize="13" />

        <!-- Fiches produites -->
        <CollectionView x:Name="FichesView" Grid.Row="2" SelectionMode="Single"
                        SelectionChanged="OnFichePicked">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Fiche">
                    <Border Style="{StaticResource NMCard}" Padding="14" Margin="2,2,2,4">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="White" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border WidthRequest="46" HeightRequest="46" BackgroundColor="{StaticResource Primary}"
                                    StrokeThickness="0" VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Style="{StaticResource NMIconGlyph}" TextColor="White" FontSize="24"
                                       Text="{x:Static f:FluentUI.document_24_regular}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <Label Text="{Binding Title}" Style="{StaticResource NMSectionTitle}" FontSize="16"
                                       LineBreakMode="TailTruncation" MaxLines="2" />
                                <Label Text="{Binding KeywordsInfo}" Style="{StaticResource NMMuted}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Style="{StaticResource NMIconGlyph}" VerticalOptions="Center"
                                   TextColor="{StaticResource NMMutedColor}"
                                   Text="{x:Static f:FluentUI.chevron_right_24_regular}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Actions -->
        <VerticalStackLayout Grid.Row="3" Spacing="10">
            <Button Text="Voir le cours" Style="{StaticResource NMPrimaryButton}" HeightRequest="54"
                    CornerRadius="27" Clicked="OnViewCourseClicked" />
            <Button Text="Terminé" Style="{StaticResource NMOutlineButton}" HeightRequest="50"
                    CornerRadius="25" Clicked="OnDoneClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
