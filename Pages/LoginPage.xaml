<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:f="clr-namespace:Fonts"
             x:Class="Notemaster.Pages.LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource NMPageColor}">
    <ScrollView>
        <!-- Fond en deux tons : bandeau bleu en haut (300), zone claire en dessous.
             La carte blanche chevauche la frontière entre les deux. -->
        <Grid RowDefinitions="300,Auto">
            <BoxView Grid.Row="0" Color="{StaticResource Primary}" />

            <!-- En-tête : logo et accroche -->
            <VerticalStackLayout Grid.Row="0" Padding="24,44,24,0" Spacing="10"
                                 HorizontalOptions="Center" VerticalOptions="Start">
                <Border WidthRequest="68" HeightRequest="68" BackgroundColor="#33FFFFFF"
                        StrokeThickness="0" HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Label Style="{StaticResource NMIconGlyph}" TextColor="White" FontSize="34"
                           Text="{x:Static f:FluentUI.book_open_32_regular}" />
                </Border>
                <Label Text="NoteMaster" Style="{StaticResource NMHeroTitle}" HorizontalOptions="Center" />
                <Label Text="Content de vous revoir" TextColor="#D9DDFB" FontSize="16"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Carte de connexion + lien d'inscription -->
            <VerticalStackLayout Grid.RowSpan="2" Margin="24,214,24,32" Spacing="22" VerticalOptions="Start"
                                 WidthRequest="{OnIdiom -1, Desktop=420, Tablet=420}" HorizontalOptions="{OnIdiom Fill, Desktop=Center, Tablet=Center}">
                <Border Style="{StaticResource NMCard}">
                    <VerticalStackLayout Spacing="16">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Email" Style="{StaticResource NMFieldLabel}" />
                            <Border Style="{StaticResource NMField}">
                                <Entry x:Name="EmailEntry" Style="{StaticResource NMEntry}"
                                       Placeholder="prenom.nom@universite.fr" Keyboard="Email" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Mot de passe" Style="{StaticResource NMFieldLabel}" />
                            <Border Style="{StaticResource NMField}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Entry x:Name="PasswordEntry" Style="{StaticResource NMEntry}"
                                           Placeholder="Votre mot de passe" IsPassword="True" />
                                    <Label x:Name="PasswordEye" Grid.Column="1" Style="{StaticResource NMIconGlyph}"
                                           TextColor="{StaticResource NMMutedColor}"
                                           Text="{x:Static f:FluentUI.eye_24_regular}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnTogglePasswordTapped" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <Label x:Name="ErrorLabel" Style="{StaticResource NMErrorLabel}" IsVisible="False" />

                        <Button Text="Se connecter" Style="{StaticResource NMPrimaryButton}"
                                Clicked="OnLoginClicked" />

                        <Label Text="Mot de passe oublié ?" Style="{StaticResource NMLink}"
                               HorizontalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnForgotTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>
                </Border>

                <Label HorizontalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Pas encore de compte ? " TextColor="{StaticResource NMMutedColor}" />
                            <Span Text="Créer un compte" TextColor="{StaticResource Primary}"
                                  FontFamily="OpenSansSemibold" />
                        </FormattedString>
                    </Label.FormattedText>
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRegisterTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
