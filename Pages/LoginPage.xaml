<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Notemaster.Pages.LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Primary}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="24" VerticalOptions="Center">
            <VerticalStackLayout Spacing="4">
                <Label Text="NoteMaster" FontSize="32" FontAttributes="Bold"
                       TextColor="White" HorizontalOptions="Center" />
                <Label Text="Content de vous revoir" TextColor="White" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Border BackgroundColor="White" Padding="20" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Entry x:Name="EmailEntry" Placeholder="Email" Keyboard="Email"
                           HeightRequest="48" TextColor="Black" PlaceholderColor="Gray" />
                    <Entry x:Name="PasswordEntry" Placeholder="Mot de passe" IsPassword="True"
                           HeightRequest="48" TextColor="Black" PlaceholderColor="Gray" />
                    <Label x:Name="ErrorLabel" TextColor="#DC2626" IsVisible="False" />
                    <Button Text="Se connecter" BackgroundColor="{StaticResource Primary}"
                            TextColor="White" HeightRequest="48" CornerRadius="12"
                            Clicked="OnLoginClicked" />
                    <Label Text="Mot de passe oublié ?" HorizontalOptions="End"
                           TextColor="{StaticResource Primary}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnForgotTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <Label Text="Pas encore de compte ? Créer un compte" TextColor="White"
                   HorizontalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRegisterTapped" />
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>