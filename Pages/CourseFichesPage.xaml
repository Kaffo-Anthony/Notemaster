<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Notemaster.Models"
             x:Class="Notemaster.Pages.CourseFichesPage"
             Title="Fiches d'un cours"
             Shell.TabBarIsVisible="False">
    <Grid Padding="20" RowSpacing="12" RowDefinitions="Auto,Auto,*,Auto">
        <Border Grid.Row="0" BackgroundColor="{StaticResource Primary}" Padding="16" StrokeThickness="0">
            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
            <VerticalStackLayout>
                <Label x:Name="CourseTitle" TextColor="White" FontSize="20" FontAttributes="Bold" />
                <Label x:Name="CourseCount" TextColor="White" FontSize="13" />
            </VerticalStackLayout>
        </Border>

        <SearchBar Grid.Row="1" Placeholder="Rechercher une fiche..." TextChanged="OnSearchChanged" />

        <CollectionView x:Name="FichesView" Grid.Row="2" SelectionMode="Single"
                        SelectionChanged="OnFichePicked">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Fiche">
                    <Border BackgroundColor="White" Stroke="#E5E7EB" Padding="14">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Title}" FontAttributes="Bold" TextColor="Black" />
                            <Label Text="{Binding Preview}" FontSize="13" TextColor="#4B5563" />
                            <Label Text="{Binding KeywordsInfo}" FontSize="12"
                                   TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label x:Name="EmptyLabel" Grid.Row="2" IsVisible="False" HorizontalOptions="Center"
               VerticalOptions="Center" HorizontalTextAlignment="Center" TextColor="#6B7280" />

        <Button Grid.Row="3" Text="Ajouter une note" BackgroundColor="{StaticResource Primary}"
                TextColor="White" HeightRequest="52" CornerRadius="26" Clicked="OnAddNoteClicked" />
    </Grid>
</ContentPage>