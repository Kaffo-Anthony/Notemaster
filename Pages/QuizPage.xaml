<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:f="clr-namespace:Fonts"
             x:Class="Notemaster.Pages.QuizPage"
             Title="Auto-évaluation"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource NMBackground}">

    <ContentPage.Resources>
        <!-- Réponses : cartes blanches, bleu clair quand elles sont sélectionnées -->
        <Style x:Key="NMOption" TargetType="RadioButton">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="BorderColor" Value="{StaticResource NMLine}" />
            <Setter Property="BorderWidth" Value="1.5" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="TextColor" Value="{StaticResource NMText}" />
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CheckedStates">
                        <VisualState x:Name="Checked">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource NMSoft}" />
                                <Setter Property="BorderColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource NMInk}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Unchecked">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="White" />
                                <Setter Property="BorderColor" Value="{StaticResource NMLine}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20,12,20,24" Spacing="16"
                             WidthRequest="{OnIdiom -1, Desktop=420, Tablet=420}"
                             HorizontalOptions="{OnIdiom Fill, Desktop=Center, Tablet=Center}">

            <!-- ===== Génération du quiz en cours ===== -->
            <VerticalStackLayout x:Name="LoadingSection" Spacing="14" Margin="0,60,0,0">
                <ActivityIndicator IsRunning="True" Color="{StaticResource Primary}"
                                   HeightRequest="48" WidthRequest="48" HorizontalOptions="Center" />
                <Label Text="Génération du quiz en cours" Style="{StaticResource NMSectionTitle}"
                       FontSize="22" HorizontalOptions="Center" />
                <Label Text="Ton quiz se prépare..." Style="{StaticResource NMMuted}" FontSize="14"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- ===== Échec de la génération ===== -->
            <VerticalStackLayout x:Name="ErrorSection" Spacing="14" IsVisible="False" Margin="0,40,0,0">
                <Label Style="{StaticResource NMIconGlyph}" FontSize="64" TextColor="{StaticResource NMDanger}"
                       Text="{x:Static f:FluentUI.error_circle_24_regular}" />
                <Label Text="Échec de la génération" Style="{StaticResource NMSectionTitle}" FontSize="22"
                       TextColor="{StaticResource NMDanger}" HorizontalOptions="Center" />
                <Label Text="Impossible de générer le quiz. Vérifie ta connexion et réessaie."
                       Style="{StaticResource NMBody}" HorizontalTextAlignment="Center" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,6,0,0">
                    <Button Text="Réessayer" Style="{StaticResource NMPrimaryButton}" HeightRequest="48"
                            Clicked="OnRetryLoadClicked" />
                    <Button Grid.Column="1" Text="Annuler" Style="{StaticResource NMOutlineButton}"
                            HeightRequest="48" Clicked="OnBackToFicheClicked" />
                </Grid>
            </VerticalStackLayout>

            <!-- ===== Question ===== -->
            <VerticalStackLayout x:Name="QuestionSection" Spacing="14" IsVisible="False">
                <Border BackgroundColor="{StaticResource Primary}" StrokeThickness="0" Padding="12,5"
                        HorizontalOptions="Start">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Label x:Name="ProgressLabel" TextColor="White" FontFamily="OpenSansSemibold" FontSize="13" />
                </Border>
                <ProgressBar x:Name="QuizProgress" ProgressColor="{StaticResource Primary}"
                             BackgroundColor="{StaticResource NMLine}" />
                <Label x:Name="QuestionLabel" Style="{StaticResource NMSectionTitle}" FontSize="20"
                       Margin="0,4,0,2" />

                <RadioButton x:Name="Opt0" GroupName="answers" Style="{StaticResource NMOption}"
                             CheckedChanged="OnOptionChecked" />
                <RadioButton x:Name="Opt1" GroupName="answers" Style="{StaticResource NMOption}"
                             CheckedChanged="OnOptionChecked" />
                <RadioButton x:Name="Opt2" GroupName="answers" Style="{StaticResource NMOption}"
                             CheckedChanged="OnOptionChecked" />
                <RadioButton x:Name="Opt3" GroupName="answers" Style="{StaticResource NMOption}"
                             CheckedChanged="OnOptionChecked" />

                <!-- Retour correct / incorrect (couleur et texte gérés par le code) -->
                <Border x:Name="FeedbackBox" Padding="16" StrokeThickness="1.5" Stroke="Transparent"
                        IsVisible="False">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Label x:Name="FeedbackLabel" TextColor="{StaticResource NMText}" FontSize="14" />
                </Border>

                <Button x:Name="ValidateButton" Text="Valider" IsEnabled="False"
                        Style="{StaticResource NMPrimaryButton}" HeightRequest="54" CornerRadius="27"
                        Clicked="OnValidateClicked" />
                <Button x:Name="NextButton" IsVisible="False"
                        Style="{StaticResource NMPrimaryButton}" HeightRequest="54" CornerRadius="27"
                        Clicked="OnNextClicked" />
            </VerticalStackLayout>

            <!-- ===== Résultat ===== -->
            <Border x:Name="ResultSection" BackgroundColor="{StaticResource Primary}" StrokeThickness="0"
                    Padding="24,32" IsVisible="False">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="26" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Border WidthRequest="96" HeightRequest="96" BackgroundColor="#33FFFFFF" StrokeThickness="0"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="48" />
                        </Border.StrokeShape>
                        <Label Style="{StaticResource NMIconGlyph}" TextColor="White" FontSize="46"
                               Text="{x:Static f:FluentUI.trophy_24_regular}" />
                    </Border>
                    <Label x:Name="ResultTitle" Style="{StaticResource NMHeroTitle}" FontSize="30"
                           HorizontalOptions="Center" />
                    <Label x:Name="ScoreLabel" Style="{StaticResource NMHeroTitle}" FontSize="64"
                           HorizontalOptions="Center" />
                    <Label x:Name="ResultMessage" TextColor="#D9DDFB" FontSize="15"
                           HorizontalTextAlignment="Center" />
                    <Button Text="Réessayer le quiz" BackgroundColor="White" TextColor="{StaticResource Primary}"
                            FontFamily="OpenSansSemibold" FontSize="16" BorderWidth="0" HeightRequest="52"
                            CornerRadius="14" Margin="0,10,0,0" Clicked="OnRetryQuizClicked" />
                    <Button Text="Retour à la fiche" BackgroundColor="Transparent" TextColor="White"
                            BorderColor="White" BorderWidth="1.5" FontFamily="OpenSansSemibold" FontSize="16"
                            HeightRequest="52" CornerRadius="14" Clicked="OnBackToFicheClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
